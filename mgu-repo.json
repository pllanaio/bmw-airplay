{
  "schema": 1,
  "apps": {
    "path": "apps/*",
    "manifest": "app.json",
    "mguHmi": ["ID7"],
    "requires": {
      "mgu-airplay": "0.2.4",
      "mgu-uplink": "0.7.3",
      "mgu-render": "0.6.11",
      "mgu-deploy": "0.7.17"
    },
    "build": {
      "python": "tools/build_store.py",
      "args": ["--app", "{id}", "--version", "{version}", "--source", "{dir}"],
      "sdk": "oap-sdk",
      "network": true
    }
  }
}
